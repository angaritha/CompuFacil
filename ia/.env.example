# Copia este archivo como .env (en esta misma carpeta ia/) y completa los valores.

# Clave de Groq: https://console.groq.com  (API Keys)
GROQ_API_KEY=gsk_tu_clave_aqui

# Modelo de Groq (opcional)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=700
GROQ_REASONING_EFFORT=low

# Clave para entrar al panel web (http://localhost:8000/panel)
PANEL_PASSWORD=compu2026

# Cuántos mensajes recientes recuerda el Tutor IA por estudiante
TUTOR_HISTORY_TURNS=8

# Voz (accesibilidad)
GROQ_STT_MODEL=whisper-large-v3-turbo
TTS_VOICE=es-CO-SalomeNeural
TTS_RATE=+0%
